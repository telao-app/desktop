{
  "name": "telao-desktop",
  "productName": "Telao",
  "version": "0.1.2-beta.1",
  "description": "Transmissão de tela, câmera e voz para o grupo",
  "author": "Lucas Lima <luccasplima@gmail.com>",
  "main": "main.js",
  "type": "commonjs",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --publish never"
  },
  "devDependencies": {
    "electron": "^45.2.2",
    "electron-builder": "^26.18.0"
  },
  "build": {
    "appId": "app.telao",
    "files": [
      "main.js",
      "preload.js",
      "seletor.html",
      "package.json"
    ],
    "mac": {
      "target": "dmg",
      "identity": "-",
      "hardenedRuntime": false,
      "category": "public.app-category.social-networking",
      "extendInfo": {
        "CFBundleDisplayName": "Telão"
      },
      "artifactName": "Telao-mac.${ext}"
    },
    "win": {
      "target": "nsis",
      "artifactName": "Telao-windows.${ext}",
      "extraResources": [
        {
          "from": "build/telao-som.exe",
          "to": "telao-som.exe"
        }
      ]
    },
    "linux": {
      "target": "AppImage",
      "category": "Network",
      "artifactName": "Telao-linux.${ext}"
    },
    "nsis": {
      "shortcutName": "Telão"
    },
    "publish": {
      "provider": "github",
      "owner": "telao-app",
      "repo": "telao-app-desktop"
    }
  },
  "repository": "github:telao-app/telao-app-desktop",
  "dependencies": {
    "electron-updater": "^6.8.11"
  }
}
