{
  "name": "telao-desktop",
  "productName": "Telao",
  "version": "0.2.6",
  "description": "Transmissão de tela, câmera e voz para o grupo",
  "author": "Lucas Lima <luccasplima@gmail.com>",
  "main": "main.js",
  "type": "commonjs",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --linux --publish never",
    "tauri": "tauri",
    "start:tauri": "cargo run --manifest-path src-tauri/Cargo.toml",
    "dist:tauri": "tauri build"
  },
  "devDependencies": {
    "@tauri-apps/cli": "2.12.4",
    "electron": "^45.2.2",
    "electron-builder": "^26.18.0"
  },
  "build": {
    "appId": "app.telao",
    "files": [
      "main.js",
      "preload.js",
      "seletor.html",
      "package.json"
    ],
    "linux": {
      "target": "AppImage",
      "category": "Network",
      "artifactName": "Telao-linux.${ext}"
    },
    "publish": {
      "provider": "github",
      "owner": "telao-app",
      "repo": "telao-app-desktop"
    },
    "npmRebuild": false
  },
  "repository": "github:telao-app/telao-app-desktop",
  "dependencies": {
    "electron-updater": "^6.8.11",
    "uiohook-napi": "^1.5.5"
  }
}
