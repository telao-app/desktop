{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Telao",
  "mainBinaryName": "Telao",
  "version": "../package.json",
  "identifier": "app.telao",
  "build": {},
  "app": {
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "category": "SocialNetworking",
    "shortDescription": "Transmissão de tela, câmera e voz para o grupo",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "12.0",
      "hardenedRuntime": false,
      "signingIdentity": "-"
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "installerHooks": "windows/migrar-electron.nsh"
      }
    }
  }
}
